@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using BlazorDbzPersonagem.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Personagens de Dragon Ball</PageTitle>

<h1>Personagens de Dragon Ball</h1>
<p>Digite o ID de um personagem para consultar a API.</p>

<div class="mb-3">
    <label for="personagemId" class="form-label">ID do personagem</label>
    <input id="personagemId"
           type="number"
           min="1"
           class="form-control"
           style="max-width: 260px"
           @bind="idPersonagem" />
</div>

<button class="btn btn-primary" @onclick="BuscarPersonagem" disabled="@carregando">
    @(carregando ? "Buscando..." : "Buscar personagem")
</button>

@if (!string.IsNullOrWhiteSpace(mensagem))
{
    <p class="mt-3" role="alert">@mensagem</p>
}

@if (personagem is not null)
{
    <section class="mt-4">
        <h2>Nome: @personagem.Nome</h2>
        <p><strong>ID:</strong> @personagem.Id</p>
        <p><strong>Planeta de origem:</strong> @(personagem.PlanetaOrigem?.Nome ?? "Não informado")</p>

        <h3>Transformações</h3>

        @if (personagem.Transformacoes.Count > 0)
        {
            <ul>
                @foreach (var transformacao in personagem.Transformacoes)
                {
                    <li>@transformacao.Nome</li>
                }
            </ul>
        }
        else
        {
            <p>Nenhuma transformação encontrada para este personagem.</p>
        }
    </section>
}

@code {
    private int idPersonagem = 1;
    private Personagem? personagem;
    private string mensagem = "";
    private bool carregando;

    private async Task BuscarPersonagem()
    {
        mensagem = "";
        personagem = null;

        if (idPersonagem < 1)
        {
            mensagem = "Digite um ID maior que zero.";
            return;
        }

        carregando = true;

        try
        {
            var http = HttpClientFactory.CreateClient();
            var url = $"https://dragonball-api.com/api/characters/{idPersonagem}";

            personagem = await http.GetFromJsonAsync<Personagem>(url);

            if (personagem is null)
            {
                mensagem = "A API não retornou dados para esse personagem.";
            }
        }
        catch (HttpRequestException)
        {
            mensagem = "Não foi possível acessar a API. Verifique sua conexão e tente novamente.";
        }
        catch (System.Text.Json.JsonException)
        {
            mensagem = "Não foi possível interpretar os dados retornados pela API.";
        }
        finally
        {
            carregando = false;
        }
    }
}
